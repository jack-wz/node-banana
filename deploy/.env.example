# Copy to .env and fill in real values. Never commit .env.

# Connection to the shared ParadeDB instance on the WeKnora network.
# Host "postgres" resolves via the external weknora_WeKnora-network.
# The nodebanana role/database are created once by the setup steps in
# docs/nas-persistence-research/06-部署运维手册.md
DATABASE_URL=postgres://nodebanana:CHANGE_ME@postgres:5432/nodebanana

# Team media directory on the NAS (mounted into the container as /data)
DATA_DIR=/vol1/1000/吴越 AI 媒体创作/node-banana/data
